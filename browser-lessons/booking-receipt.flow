Feature: Approve a booking across browser profiles and download its receipt
import { createPracticeDriver } from "practice/user-fixtures.ts";

Scenario: The driver receives the receipt for the booking the admin approved
  Given "Create a disposable driver and sign into the driver profile"
    flow.fixture.use createPracticeDriver() as "driver";
    flow.open "/login";
    flow.type input "Email" "@driver.email";
    flow.passcode input "Password" "@driver.password";
    flow.click button "Sign in";
  When "Book Kite 001 and capture its reference"
    flow.open "/cars/CAR-001";
    flow.set input "Pickup date" to "2030-07-03";
    flow.set input "Return date" to "2030-07-06";
    flow.click button "Place booking";
    flow.assert.that {"selector":".booking .status","condition":"text","value":"Awaiting approval"};
    flow.extract attribute ".booking" "data-booking-id" as "bookingId";
  When "Approve the same booking from the admin's independent profile"
    flow.browser.create {"name":"admin"};
    flow.open "/login";
    flow.type input "Email" "admin@example.test";
    flow.passcode input "Password" "practice-admin";
    flow.click button "Sign in";
    flow.assert.that {"selector":"#@bookingId .status","condition":"text","value":"Awaiting approval"};
    flow.click "#@bookingId button";
    flow.assert.that {"selector":"#@bookingId","condition":"count","value":0};
  When "Return to the driver profile and open the approved receipt in a new tab"
    flow.browser.use {"name":"default"};
    flow.open "/bookings/@bookingId";
    flow.tab.name {"name":"booking"};
    flow.tab.arm {"name":"receipt","timeout":5000};
    flow.click link "View receipt";
    flow.tab.use {"name":"receipt"};
    flow.expect visible "Booking receipt";
    flow.assert.that {"selector":"#receipt-id","condition":"text","value":"@bookingId"};
  When "Download the receipt"
    flow.download.arm {"name":"booking-receipt","timeout":5000};
    flow.click link "Download receipt";
    flow.download.save {"name":"booking-receipt","file":"flowstride-artifacts/receipts/receipt-$uuid.json"};
  Then "The booking reference and total in the file match the approved booking"
    flow.assert.that {"selector":"#receipt-total","condition":"text","value":"$324.00"};
    flow.download.expect {
      "name":"booking-receipt",
      "filename":"receipt-@bookingId.json",
      "json":{
        "bookingId":"@bookingId",
        "sku":"CAR-001",
        "pickupDate":"2030-07-03",
        "returnDate":"2030-07-06",
        "days":3,
        "totalCents":32400,
        "currency":"USD"
      }
    };
