Feature: Keep the evidence from a failed receipt attempt
import { createReceiptRetryBooking } from "practice/user-fixtures.ts";

Scenario: The same approved booking opens after one deliberate receipt failure
  Given "Reuse one approved booking across attempts"
    flow.fixture.worker createReceiptRetryBooking() as "receipt";
    flow.open "/login";
    flow.type input "Email" "@receipt.email";
    flow.passcode input "Password" "@receipt.password";
    flow.click button "Sign in";
  When "Open the receipt page for that booking"
    flow.open "/bookings/@receipt.bookingId/receipt";
  Then "The receipt displays that booking reference"
    flow.assert.that {"selector":"#receipt-id","condition":"text","value":"@receipt.bookingId","timeout":2000};
