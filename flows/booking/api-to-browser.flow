Feature: Book through the API and verify approval in the browser
import { createPracticeDriver } from "practice/user-fixtures.ts";

Scenario: The same booking is visible before and after admin approval
  Given "Create a temporary driver and an API session"
    flow.fixture.use createPracticeDriver() as "driver";
    flow.api.create {"name":"driver","cookies":true};
    flow.api.use {"name":"driver"};
    flow.api.request {
      "method":"POST","url":"/api/session",
      "json":{"email":"@driver.email","password":"@driver.password"}
    };
    flow.expect status "200";
  When "Book Harbor 011 through the API"
    flow.api.request {
      "method":"POST","url":"/api/bookings",
      "json":{"sku":"CAR-011","pickupDate":"2030-06-12","returnDate":"2030-06-14","payment":"success"}
    };
    flow.expect status "201";
    flow.expect resBody "status" equals "pending";
    flow.extract resBody "id" as "bookingId";
  When "Approve that booking in the admin browser"
    flow.open "/login";
    flow.type input "Email" "admin@example.test";
    flow.passcode input "Password" "practice-admin";
    flow.click button "Sign in";
    flow.click link "Review bookings";
    flow.expect visible "@bookingId";
    flow.click "#@bookingId button";
    flow.assert.that {"selector":"[data-booking-id='@bookingId'] .status","condition":"text","value":"Approved"};
    flow.click button "Sign out";
  When "Sign in through the browser as the driver"
    flow.type input "Email" "@driver.email";
    flow.passcode input "Password" "@driver.password";
    flow.click button "Sign in";
    flow.click link "My bookings";
    flow.assert.that {"selector":"[data-booking-id='@bookingId'] .status","condition":"text","value":"Approved"};
    flow.click "#@bookingId button";
  Then "Read the matching cancelled record through the API"
    flow.assert.that {"selector":"[data-booking-id='@bookingId'] .status","condition":"text","value":"Cancelled"};
    flow.api.request {"method":"GET","url":"/api/bookings/@bookingId"};
    flow.expect status "200";
    flow.expect resBody "id" equals "@bookingId";
    flow.expect resBody "status" equals "cancelled";
