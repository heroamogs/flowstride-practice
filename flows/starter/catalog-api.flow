Feature: Search and sort the practice catalog through the API
import { summarizeCatalog } from "practice/catalog-summary.js";

Scenario: Filter hatchbacks and check their order
  Given "Request the catalog"
    flow.get "/api/cars?category=Hatchback&sort=price-asc";
    flow.expect status "200";
    flow.extract resBody "cars" as "cars";
  When "Summarize the response with a JavaScript helper"
    flow.call summarizeCatalog("@cars") as "summary";
  Then "The filtered catalog has ten cars and is sorted by price"
    flow.assert.value {"actual":"@summary.count","operator":"equals","expected":10};
    flow.assert.value {"actual":"@summary.sorted","operator":"equals","expected":true};
